import backtrader as bt
import backtrader.indicators as btind
import numpy as np
import pandas as pd
from datetime import datetime, timedelta

class CustomPandasData(bt.feeds.PandasData):
    """
    Custom PandasData class to include confirmed_signal and sr_level as data lines
    """
    # Define the lines
    lines = ('confirmed_signal', 'sr_level', 'volume_ratio', 'adx', 'pattern')
    
    # Define the parameters - these map DataFrame columns to lines
    params = (
        ('confirmed_signal', 'confirmed_signal'),  
        ('sr_level', 'sr_level'),
        ('volume_ratio', 'volume_ratio'),
        ('adx', 'adx'),
        ('pattern', 'pattern'),
        ('open', 'open'),
        ('high', 'high'),
        ('low', 'low'),
        ('close', 'close'),
        ('volume', 'volume'),
        ('openinterest', None),  # Optional since it may not be in DF
    )

class Trade:
    """Simple class to track trade information for charting"""
    def __init__(self, entry_price, entry_time, is_long=True):
        self.entry_price = entry_price
        self.entry_time = entry_time
        self.exit_price = None
        self.exit_time = None
        self.is_long = is_long
        self.profit = 0
        self.profit_pct = 0
        self.status = 'open'
        self.exit_reason = None
        
    def close(self, exit_price, exit_time, exit_reason=None):
        self.exit_price = exit_price
        self.exit_time = exit_time
        self.exit_reason = exit_reason
        self.status = 'closed'
        # Calculate profit/loss
        mult = 1 if self.is_long else -1
        self.profit_pct = ((exit_price / self.entry_price) - 1) * 100 * mult
        self.profit = (exit_price - self.entry_price) * mult

class TripleScreenStrategy(bt.Strategy):
    """
    Triple Screen Trading Strategy Implementation
    """
    params = (
        # Higher timeframe trend
        ('higher_tf_trend', 1),  # 1 = bullish, -1 = bearish
        
        # Middle timeframe params
        ('rsi_period', 14),
        ('rsi_overbought', 70),
        ('rsi_oversold', 30),
        ('macd_fast', 12),
        ('macd_slow', 26),
        ('macd_signal', 9),
        
        # Lower timeframe params
        ('atr_period', 14),
        ('risk_pct', 1.0),
        ('trailing_pct', 1.0),
        ('profit_target_atr_mult', 3.0),
        ('risk_reward_ratio', 2.0),
        ('max_positions', None),
        ('volume_ema_period', 20),
        ('min_volume_ratio', 1.0),
        ('trail_atr_mult', 1.5),  # ATR multiplier for trailing stop
        ('min_trail_distance', 0.5),  # Min profit % before trailing
        # Stock-specific optimization parameters
        ('jiofin_trail_atr_mult', 1.5),  # JIOFIN-specific ATR multiplier
        ('reliance_trail_atr_mult', 1.2),  # RELIANCE-specific ATR multiplier
        ('sbi_trail_atr_mult', 1.5),  # SBI-specific ATR multiplier
        ('tcs_trail_atr_mult', 1.8),  # TCS-specific ATR multiplier
        ('bel_trail_atr_mult', 1.8),  # BEL-specific ATR multiplier
        ('lici_trail_atr_mult', 1.0),  # LICI-specific ATR multiplier
        ('use_stock_specific_params', True),  # Whether to use stock-specific parameters
    )
    
    def __init__(self):
        super(TripleScreenStrategy, self).__init__()
        
        # Check for required parameter: max_positions
        if self.p.max_positions is None:
            raise ValueError("[TripleScreenStrategy] 'max_positions' parameter must be set explicitly (e.g., from config). Do not rely on the class default.")
        # Always initialize trade_stats so it exists on the instance
        self.trade_stats = {}
        # Initialize variables for trade tracking
        self.trades_executed = 0
        self.trades_won = 0
        self.trades_lost = 0
        self.trades_breakeven = 0
        self.total_profit = 0.0
        self.total_loss = 0.0
        self.trades = []  # List to store trade details
        self.trades_active = 0
        self.position_count = 0 
        self.signals_processed = 0
        self.signals_executed = 0
        self.signals_ignored = 0
        
        # Dictionary to track positions and their info
        self.pos_tracker = {}
        self.stop_orders = {}
        self.order_dict = {}  # Track order references and their entry prices
        self.profit_target_orders = {}
        self.total_holding_periods_winners = 0
        self.total_holding_periods_losers = 0
        self.active_positions = 0
        self.exit_reasons = {}
        self.signals_executing = 0
        self.exits_by_take_profit = 0
        self.exits_by_stop_loss = 0
        self.exits_by_trailing_stop = 0
        
        # Initialize signal tracking
        self.use_signal_line = False
        # Check if the data has a confirmed_signal attribute
        if hasattr(self.datas[0].lines, 'confirmed_signal'):
            self.use_signal_line = True
            # self.log("Using confirmed_signal from data feed")
        else:
            # self.log("No confirmed_signal in data, using strategy's own signals")
            pass
        
        # Initialize indicators
        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)
        self.rsi = bt.indicators.RSI(self.data, period=14)
        self.ema = bt.indicators.EMA(self.data, period=20)
        self.macd = bt.indicators.MACD(self.data)
        self.macd_hist = self.macd.macd - self.macd.signal
        # Bollinger Bands
        self.bbands = bt.indicators.BollingerBands(self.data.close, period=20, devfactor=2)
        
        # Determine stock-specific parameters
        self.stock_code = self.datas[0].stock_code if hasattr(self.datas[0], 'stock_code') else None
        self.trail_activated = {}  # Track if trailing is activated for each position
        
        # Set stock-specific trailing stop parameters if available
        if self.p.use_stock_specific_params and self.stock_code:
            stock_param_name = f"{self.stock_code.lower()}_trail_atr_mult"
            if hasattr(self.p, stock_param_name):
                self.effective_trail_atr_mult = getattr(self.p, stock_param_name)
                # self.log(f"Using stock-specific ATR multiplier for {self.stock_code}: {self.effective_trail_atr_mult}")
            else:
                self.effective_trail_atr_mult = self.p.trail_atr_mult
        else:
            self.effective_trail_atr_mult = self.p.trail_atr_mult
            
        # Logging
        # self.log(f"Strategy initialized with {self.p.max_positions} max positions and ATR trailing stop multiplier: {self.effective_trail_atr_mult}")
        
    def log(self, txt, dt=None):
        """Enhanced logging function with more detail"""
        dt = dt or self.datas[0].datetime.datetime(0)
        log_text = f'{dt.isoformat()}: {txt}'
        # print(f'[BT] {log_text}')
        
    def should_buy(self):
        """Determine if we should buy based on strategy rules
        
        Base (strict) version requires all conditions to be met:
        1. Price must be above EMA
        2. MACD must be positive
        3. RSI should be above 50 (stronger trend)
        4. ATR should not be extremely low (sufficient volatility)
        """
        # IMPORTANT: Never create indicators here - they must be created in __init__
        # Check if we have enough data for lookback
        if len(self) < 30:  # Need at least 30 bars for reliable indicators
            return False
            
        # Get current values (with safety checks)
        try:
            price = self.data.close[0]
            rsi_val = self.rsi[0]
            macd_val = self.macd.macd[0]
            ema_val = self.ema[0]
            
            # Strict conditions (all must be met)
            trend_bullish = True  # Default value if higher_tf_trend not available
            if hasattr(self, 'p') and hasattr(self.p, 'higher_tf_trend'):
                trend_bullish = self.p.higher_tf_trend > 0
                
            price_above_ema = price > ema_val
            macd_bullish = macd_val > 0
            rsi_bullish = rsi_val > 50  # RSI above 50 = bullish momentum
            
            # Check if we have enough data for ATR lookback
            if len(self) > 15:  # Need data for ATR comparison
                atr_ok = self.atr[0] > self.atr[-10] * 0.5  # Make sure ATR is not extremely low
            else:
                atr_ok = True  # Default when not enough data
        except IndexError:
            # If any index errors occur, we don't have enough data yet
            return False
        
        # Classic Triple Screen Logic
        return trend_bullish and price_above_ema and macd_bullish and rsi_bullish and atr_ok
    
    def should_sell(self):
        """Determine if we should sell based on strategy rules
        
        Sell conditions in strict strategy:
        1. Trend reversal (MACD crosses below zero)
        2. Overbought condition (RSI above 70)
        3. Price moves below EMA with increased volume
        4. Trailing stop activated and price below current stop
        """
        # We already ensure indicators are created in should_buy
        if not hasattr(self, 'rsi') or not hasattr(self, 'ema') or not hasattr(self, 'macd'):
            return False  # Safety check
        
        price = self.data.close[0]
        rsi_val = self.rsi[0]
        macd_val = self.macd.macd[0]
        macd_signal = self.macd.signal[0]
        ema_val = self.ema[0]
        
        # Exit signals
        trend_bearish = macd_val < 0 and macd_val < macd_signal  # MACD below zero and signal
        overbought = rsi_val > 70  # RSI overbought
        price_below_ema = price < ema_val and self.data.volume[0] > self.data.volume[-1]  # Price below EMA with volume
        
        # Strict exit - any single condition can trigger exit
        return trend_bearish or overbought or price_below_ema
    
    def create_position_object(self, size, price, is_long=True):
        """Create a simple position tracking object"""
        return {
            'size': size,
            'price': price,
            'is_long': is_long,
            'entry_time': len(self),
            'exit_price': None,
            'exit_time': None
        }
        
    def update_trailing_stop(self, pos_key):
        """Update trailing stop for a position with improved ATR-based logic"""
        if pos_key not in self.pos_tracker or pos_key not in self.stop_orders:
            return
            
        position = self.pos_tracker[pos_key]
        stop_order = self.stop_orders[pos_key]
        
        # Calculate new stop price based on ATR
        if position.size > 0:  # Long position
            # Use ATR-based trailing stop if enabled
            if self.effective_trail_atr_mult > 0:
                # Calculate current profit percentage
                current_price = self.data.close[0]
                entry_price = position.price
                profit_pct = (current_price - entry_price) / entry_price * 100
                
                # Only adjust stop if profit exceeds minimum threshold
                if profit_pct >= self.p.min_trail_distance:
                    # Mark trailing as activated for this position
                    self.trail_activated[pos_key] = True
                    
                    # Calculate new stop based on ATR
                    new_stop = current_price - self.effective_trail_atr_mult * self.atr[0]
                    
                    # Only move stop up, never down
                    if new_stop > stop_order.price:
                        self.cancel(stop_order)
                        new_stop_order = self.sell(size=position.size, exectype=bt.Order.Stop, price=new_stop, parent=None, transmit=True)
                        self.stop_orders[pos_key] = new_stop_order
                        # self.log(f"Trailing stop updated for position {pos_key}: {new_stop:.2f} (ATR: {self.atr[0]:.2f}, Profit: {profit_pct:.1f}%)")
            else:
                # Original trailing stop logic (percentage-based)
                new_stop = position.price * (1.0 - self.p.trailing_pct / 100.0)
                if new_stop > stop_order.price:
                    self.cancel(stop_order)
                    new_stop_order = self.sell(size=position.size, exectype=bt.Order.Stop, price=new_stop, parent=None, transmit=True)
                    self.stop_orders[pos_key] = new_stop_order
                    # self.log(f"Trailing stop updated for position {pos_key}: {new_stop:.2f} (percentage-based)")
        else:  # Short position
            # Use ATR-based trailing stop if enabled
            if self.effective_trail_atr_mult > 0:
                # Calculate current profit percentage
                current_price = self.data.close[0]
                entry_price = position.price
                profit_pct = (entry_price - current_price) / entry_price * 100
                
                # Only adjust stop if profit exceeds minimum threshold
                if profit_pct >= self.p.min_trail_distance:
                    # Mark trailing as activated for this position
                    self.trail_activated[pos_key] = True
                    
                    # Calculate new stop based on ATR
                    new_stop = current_price + self.effective_trail_atr_mult * self.atr[0]
                    
                    # Only move stop down, never up
                    if new_stop < stop_order.price:
                        self.cancel(stop_order)
                        new_stop_order = self.buy(size=abs(position.size), exectype=bt.Order.Stop, price=new_stop, parent=None, transmit=True)
                        self.stop_orders[pos_key] = new_stop_order
                        # self.log(f"Trailing stop updated for short position {pos_key}: {new_stop:.2f} (ATR: {self.atr[0]:.2f}, Profit: {profit_pct:.1f}%)")
            else:
                # Original trailing stop logic for shorts
                new_stop = position.price * (1.0 + self.p.trailing_pct / 100.0)
                if new_stop < stop_order.price:
                    self.cancel(stop_order)
                    new_stop_order = self.buy(size=abs(position.size), exectype=bt.Order.Stop, price=new_stop, parent=None, transmit=True)
                    self.stop_orders[pos_key] = new_stop_order
                    # self.log(f"Trailing stop updated for short position {pos_key}: {new_stop:.2f} (percentage-based)")
    
    def next(self):
        """Called for each bar - main strategy logic"""
        # Update existing positions
        for pos_key in list(self.pos_tracker.keys()):
            self.update_trailing_stop(pos_key)
        
        # Check if we're near the end of the dataset and should close all positions
        # This helps ensure we have profit/loss data for all trades
        remaining_bars = len(self.data) - len(self.data.array)
        if remaining_bars < 10 and len(self.pos_tracker) > 0:
            # Suppress logs for force closing positions at end of backtest
            for pos_key in list(self.pos_tracker.keys()):
                if pos_key in self.pos_tracker:
                    self.close()
        
        # Check for new signals
        if len(self.datas) > 0:
            # Get signal either from data feed or generate our own
            signal = 0
            if self.use_signal_line:
                signal = self.datas[0].lines.confirmed_signal[0]
            else:
                # Generate our own signal based on strategy conditions
                if self.should_buy():
                    signal = 1
            
            # Process the signal if there is one
            if signal != 0:
                # Count all detected signals
                self.signals_processed += 1
                # Only log if trade is actually executed
                if self.position_count < self.p.max_positions:
                    # Execute the trade
                    order = self.buy(size=100, exectype=bt.Order.Market, transmit=True)
                    # Create position tracking entry with unique key
                    pos_key = f"pos_{self.position_count}"
                    entry_price = self.data.close[0]
                    self.pos_tracker[pos_key] = self.create_position_object(100, entry_price, True)
                    self.position_count += 1
                    self.trades_executed += 1  # Increment executed trades counter
                    self.signals_executed += 1  # Count executed signals
                    # Store the order reference and entry price for later P&L calculation
                    self.order_dict[order.ref] = entry_price
                    # self.log(f"BUY EXECUTED: Price={entry_price:.2f}, Size=100, Key={pos_key}, OrderRef={order.ref}")
                else:
                    self.signals_ignored += 1  # Count ignored signals
                    # Do not log ignored signals to reduce log clutter
                    
    def notify_order(self, order):
        """Called when an order status changes"""
        # Log all order status changes for debugging
        order_status = ''
        if order.status == order.Submitted: order_status = 'Submitted'
        elif order.status == order.Accepted: order_status = 'Accepted'
        elif order.status == order.Partial: order_status = 'Partial'
        elif order.status == order.Completed: order_status = 'Completed'
        elif order.status == order.Canceled: order_status = 'Canceled'
        elif order.status == order.Expired: order_status = 'Expired'
        elif order.status == order.Margin: order_status = 'Margin'
        elif order.status == order.Rejected: order_status = 'Rejected'
    
        # self.log(f'ORDER {order.ref} {order_status}: Type: {"BUY" if order.isbuy() else "SELL"}')
        
        if order.status == order.Completed:
            if order.isbuy():
                # self.log(f'BUY EXECUTED: Price: {order.executed.price:.2f}, Size: {order.executed.size}, Cost: {order.executed.value:.2f}')
                pass
            else:  # Sell
                # self.log(f'SELL EXECUTED: Price: {order.executed.price:.2f}, Size: {order.executed.size}, Cost: {order.executed.value:.2f}')
                pass
                
                # Track profit/loss for sell orders if we have the entry price
                if hasattr(order, 'executed') and order.ref in self.order_dict:
                    entry_price = self.order_dict[order.ref]
                    exit_price = order.executed.price
                    size = order.executed.size
                    pnl = (exit_price - entry_price) * size
                    
                    # self.log(f'REALIZED P&L: Entry: {entry_price:.2f}, Exit: {exit_price:.2f}, P&L: {pnl:.2f}')
                    
                    # Update win/loss counters manually
                    if pnl > 0:
                        self.trades_won += 1
                        self.total_profit += pnl
                    else:
                        self.trades_lost += 1
                        self.total_loss += abs(pnl)
                        
                    # Update trade stats so they're available to the main script
                    self.trade_stats = {
                        'total': self.trades_won + self.trades_lost,
                        'wins': self.trades_won,
                        'losses': self.trades_lost,
                        'total_profit': self.total_profit,
                        'total_loss': self.total_loss,
                        'win_rate': (self.trades_won / max(1, self.trades_won + self.trades_lost)) * 100
                    }
                    
        elif order.status in [order.Canceled, order.Margin, order.Rejected, order.Expired]:
            # self.log(f'Order {order_status}: {order.ref}')
            pass

    def notify_trade(self, trade):
        """Called when a trade is completed"""
        if not trade.isclosed:
            return

        # Extract entry and exit from trade.history
        entry_price, exit_price, entry_size = None, None, None
        if hasattr(trade, "history") and trade.history:
            for event, order, size, price, comm, dt in trade.history:
                if event == 0:  # 0 = entry event
                    entry_price = price
                    entry_size = size
                elif event == 1:  # 1 = exit event
                    exit_price = price

        # Defensive: Only log if all values are valid
        if entry_price is not None and exit_price is not None and entry_size:
            pnl = trade.pnlcomm if hasattr(trade, 'pnlcomm') else trade.pnl
            # self.log(f"Order {len(self.trades)+1}:")
            # self.log(f"Entry: {entry_price:.2f}, Exit: {exit_price:.2f}, Size: {entry_size}, P&L: {pnl:.2f}")
            # self.log('-' * 60)
            # Store trade data for summary
            self.trades.append({
                'entry_price': entry_price,
                'exit_price': exit_price,
                'size': entry_size,
                'pnl': pnl,
                'entry_date': self.datetime.date().isoformat(),
                'exit_date': self.datetime.date().isoformat()
            })
        else:
            # self.log(f"[WARN] Skipped trade log due to missing entry/exit/size.")
            pass

        # Update stats as before
        profit = trade.pnlcomm if hasattr(trade, 'pnlcomm') else trade.pnl
        if profit > 0:
            self.trades_won += 1
            self.total_profit += profit
        else:
            self.trades_lost += 1
            self.total_loss += abs(profit)
        self.trade_stats = {
            'total': len(self.trades),
            'wins': self.trades_won,
            'losses': self.trades_lost,
            'total_profit': self.total_profit,
            'total_loss': self.total_loss,
            'win_rate': (self.trades_won / max(1, len(self.trades))) * 100
        }


    def stop(self):
        """Enhanced end-of-backtest reporting"""
        # Force close any open positions at the end of the backtest
        if len(self.pos_tracker) > 0:
            # self.log("Closing remaining open positions at end of backtest")
            for pos_key in list(self.pos_tracker.keys()):
                if pos_key in self.pos_tracker:  # Check again as the list might change during iteration
                    # self.log(f"Forcing close of position {pos_key}")
                    self.close()
        
        self.log(f"Net profit: {self.total_profit - self.total_loss:.2f}")

        # Manually account for any position still open that Backtrader did not mark as closed
        if len(self.pos_tracker) > 0:
            # self.log(f"[WARN] Some positions remained open after force close – accounting for P&L manually. pos_tracker: {self.pos_tracker}")
            for pos_key, pos in list(self.pos_tracker.items()):
                current_price = self.data.close[0]
                # Support both dict and object for pos
                if isinstance(pos, dict):
                    size = pos.get('size', 0)
                    entry_price = pos.get('price', 0)
                else:
                    size = getattr(pos, 'size', 0)
                    entry_price = getattr(pos, 'price', 0)
                profit = (current_price - entry_price) * size

                # Update stats just like notify_trade would
                self.trades_executed += 1
                if profit > 0:
                    self.trades_won += 1
                    self.total_profit += profit
                elif profit < 0:
                    self.trades_lost += 1
                    self.total_loss += abs(profit)
                else:
                    self.trades_breakeven += 1

            # After manual accounting, clear pos_tracker
            self.pos_tracker.clear()

            # Refresh win rate after manual adjustments
            win_rate = (self.trades_won / max(1, self.trades_executed)) * 100

        # Update trade_stats dict after manual P&L adjustments
        self.trade_stats = {
            'total': self.trades_executed,
            'wins': self.trades_won,
            'losses': self.trades_lost,
            'breakeven': self.trades_breakeven,
            'total_profit': self.total_profit,
            'total_loss': self.total_loss,
            'win_rate': (self.trades_won / max(1, self.trades_executed)) * 100,
            'loss_rate': (self.trades_lost / max(1, self.trades_executed)) * 100,
            'breakeven_rate': (self.trades_breakeven / max(1, self.trades_executed)) * 100
        }

        # Print detailed trade summary
        self.log("------- Individual Trade Results -------")
        for idx, t in enumerate(self.trades, 1):
            self.log(f"Order {idx}:")
            entry = t.get('entry_price', 0)
            exit_ = t.get('exit_price', None)
            size = t.get('size', 0)
            pnl = t.get('pnl', 0)
            if exit_ is not None:
                trade_summary = (
                    f"Entry: {entry:.2f}, Exit: {exit_:.2f}, Size: {size}, P&L: {pnl:.2f}"
                )
            else:
                trade_summary = (
                    f"Entry: {entry:.2f}, Exit: N/A, Size: {size}, P&L: {pnl:.2f}"
                )
            self.log(trade_summary)
            # self.log('-' * 60)

        # Report on signals
        self.log(f"Total signals detected: {self.signals_processed}")
        self.log(f"Signals executed (trades placed): {self.signals_executed}")
        self.log(f"Signals ignored (max positions reached): {self.signals_ignored}")
        # Store trade stats for the main program to access
        self.trade_stats = {
            'total': self.trades_executed,
            'wins': self.trades_won,
            'losses': self.trades_lost,
            'total_profit': self.total_profit,
            'total_loss': self.total_loss,
            'win_rate': win_rate,
            'signals_detected': self.signals_processed
        }
        # Report on exit reasons
        if hasattr(self, 'exit_reasons'):
            for reason, count in self.exit_reasons.items():
                self.log(f"Exits by {reason}: {count}")

    def get_trade_data(self):
        """Return trade data for charting"""
        return self.trades

def add_triple_screen_signals(df, higher_trend, rsi_period=14, rsi_overbought=70, 
                              rsi_oversold=30, macd_fast=12, macd_slow=26, macd_signal=9):
    """
    Add Triple Screen signals to a DataFrame.
    Returns DataFrame with 'confirmed_signal' column: 1 for buy, -1 for sell, 0 for no signal
    """
    # Create a copy to avoid modifying the original
    result_df = df.copy()
    
    # Add MACD indicator
    # Fast EMA
    result_df['ema_fast'] = result_df['close'].ewm(span=macd_fast, adjust=False).mean()
    # Slow EMA
    result_df['ema_slow'] = result_df['close'].ewm(span=macd_slow, adjust=False).mean()
    # MACD Line
    result_df['macd'] = result_df['ema_fast'] - result_df['ema_slow']
    # Signal Line
    result_df['macd_signal'] = result_df['macd'].ewm(span=macd_signal, adjust=False).mean()
    # MACD Histogram
    result_df['macd_hist'] = result_df['macd'] - result_df['macd_signal']
    
    # Add RSI indicator
    delta = result_df['close'].diff()
    gain = delta.where(delta > 0, 0)
    loss = -delta.where(delta < 0, 0)
    avg_gain = gain.rolling(window=rsi_period).mean()
    avg_loss = loss.rolling(window=rsi_period).mean()
    rs = avg_gain / avg_loss
    result_df['rsi'] = 100 - (100 / (1 + rs))
    
    # Add volume indicators
    # Volume EMA to identify high volume
    result_df['volume_ema'] = result_df['volume'].ewm(span=20, adjust=False).mean()
    # Volume ratio (current volume / average volume)
    result_df['volume_ratio'] = result_df['volume'] / result_df['volume_ema']
    
    # Identify support and resistance levels using swing highs/lows
    window = 5  # Look back/forward periods for highs and lows
    result_df['pivot_high'] = result_df['high'].rolling(window=window*2+1, center=True).apply(
        lambda x: 1 if x.iloc[window] == max(x) else 0, raw=False)
    result_df['pivot_low'] = result_df['low'].rolling(window=window*2+1, center=True).apply(
        lambda x: 1 if x.iloc[window] == min(x) else 0, raw=False)
    
    # Initialize support/resistance levels
    result_df['resistance'] = np.nan
    result_df['support'] = np.nan
    
    # Populate resistance levels at pivot highs
    result_df.loc[result_df['pivot_high'] == 1, 'resistance'] = result_df['high']
    
    # Populate support levels at pivot lows
    result_df.loc[result_df['pivot_low'] == 1, 'support'] = result_df['low']
    
    # Forward fill support and resistance levels
    result_df['resistance'] = result_df['resistance'].ffill()
    result_df['support'] = result_df['support'].ffill()
    
    # Add support/resistance levels for stop loss calculation
    result_df['sr_level'] = 0.0
    
    # Initialize confirmed_signal column
    result_df['confirmed_signal'] = 0
    
    # Detect MACD crossovers and RSI conditions
    for i in range(1, len(result_df)):
        # MACD Crossover (Signal Line)
        macd_crossover = (result_df['macd'].iloc[i-1] < result_df['macd_signal'].iloc[i-1]) and \
                         (result_df['macd'].iloc[i] > result_df['macd_signal'].iloc[i])
        
        # RSI conditions
        rsi_bullish = result_df['rsi'].iloc[i] > 50 and result_df['rsi'].iloc[i-1] <= 50
        rsi_not_overbought = result_df['rsi'].iloc[i] < rsi_overbought
        
        # Volume confirmation - high volume on signal day
        high_volume = result_df['volume_ratio'].iloc[i] > 1.0
        
        # For Triple Screen, we only take signals in the direction of the higher timeframe trend
        if higher_trend == 1:  # Bullish trend
            # Buy signal: MACD crosses above signal line or RSI crosses above 50 
            # while MACD is above signal line, with high volume
            if (macd_crossover or (rsi_bullish and result_df['macd'].iloc[i] > result_df['macd_signal'].iloc[i])) and \
               rsi_not_overbought and high_volume:
                result_df.loc[result_df.index[i], 'confirmed_signal'] = 1
                
                # Use actual support level if available, otherwise default to 0.5% below price
                if not pd.isnull(result_df['support'].iloc[i]):
                    # Use the latest support level for stop loss
                    result_df.loc[result_df.index[i], 'sr_level'] = result_df['support'].iloc[i]
                else:
                    # Default to 0.5% below current price if no clear support level
                    result_df.loc[result_df.index[i], 'sr_level'] = result_df['close'].iloc[i] * 0.995
        
    return result_df
